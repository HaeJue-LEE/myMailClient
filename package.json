{
  "name": "mail-client",
  "productName": "Mail Client",
  "version": "0.1.6",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,app \"next dev\" \"npm:dev:app\"",
    "dev:app": "node scripts/dev-electron.mjs",
    "build:web": "next build",
    "build:electron": "node --env-file-if-exists=.env.local scripts/build-electron.mjs",
    "build:electron:public": "node scripts/build-electron.mjs --public",
    "build": "npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "dist": "node scripts/dist-public.mjs --local",
    "dist:public": "node scripts/dist-public.mjs",
    "dist:mac": "node scripts/dist-mac.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "devDependencies": {
    "@googleapis/gmail": "^22.0.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@tanstack/react-query": "^5.107.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "dompurify": "^3.4.17",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "google-auth-library": "^11.3.4",
    "imapflow": "^2.11.0",
    "jsdom": "^31.0.0",
    "mailparser": "^3.14.3",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "p-limit": "^7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "description": "Gmail desktop mail client",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.local.mailclient",
    "productName": "Mail Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "out/**",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  }
}
